---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Solicitar acceso · ImportControl — Contacto directo';
const description = 'Solicita acceso a ImportControl. Contacto directo: Telegram @mcdk8s, WhatsApp +53 58312390, correo manuel920928@gmail.com. Respuesta en español.';
---

<BaseLayout title={title} description={description} ogImage="/og-image.png">
  <!-- Toolbar — translucent material (Apple §12) -->
  <div class="sticky top-[52px] z-30 border-b border-white/20 bg-white/60 backdrop-blur-[20px] supports-[backdrop-filter]:bg-white/60" style="backdrop-filter: blur(20px) saturate(180%); -webkit-backdrop-filter: blur(20px) saturate(180%);">
    <div class="mx-auto max-w-[1280px] px-4 md:px-6 h-[44px] flex items-center justify-between gap-3 text-[12px]">
      <div class="flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        <span class="font-mono font-semibold tracking-[0.12em] text-ink">SOLICITUD DE ACCESO</span>
        <span class="hidden sm:inline font-mono text-muted">· respuesta directa · sin formularios externos</span>
      </div>
      <a href="/" class="pressable inline-flex items-center gap-1.5 rounded-full bg-ink text-white px-3.5 py-1.5 text-[11px] font-semibold hover:bg-black transition-colors">
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3L5 8L10 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Volver a la landing
      </a>
    </div>
  </div>

  <section class="relative overflow-hidden bg-page border-b border-border">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_60%_at_20%_0%,rgba(16,124,16,0.09),transparent_70%)]"></div>
      <div class="absolute -right-20 -top-20 w-[520px] h-[520px] rounded-full bg-primary/[0.06] blur-[50px]"></div>
    </div>
    <div class="relative mx-auto max-w-[1280px] px-4 md:px-6 py-7 md:py-10">
      <div class="max-w-[780px] will-change-transform" data-spring-enter>
        <p class="inline-flex items-center gap-2 rounded-full border border-white/40 bg-white/70 backdrop-blur px-3 py-1 font-mono text-[11px] font-semibold tracking-wide text-muted shadow-sm" style="backdrop-filter: blur(12px);">
          <span class="w-1.5 h-1.5 rounded-full bg-primary"></span> CONTACTO DIRECTO · CUBA
        </p>
        <!-- Apple §15: tracking size-specific, tight leading for display -->
        <h1 class="mt-3 font-sans text-[30px] md:text-[40px] font-semibold tracking-tight text-ink leading-[1.05] text-balance" style="letter-spacing: -0.02em; font-optical-sizing: auto;">Solicitar acceso a ImportControl</h1>
        <p class="mt-3 text-[15px] leading-[1.6] text-muted max-w-[60ch]">Escríbeme directo y coordinamos el acceso. Sin formularios eternos: eliges tu canal preferido — <span class="font-semibold text-ink">Telegram, WhatsApp o correo</span> — y te respondo en español.</p>
      </div>
    </div>
    <!-- Scroll edge mask instead of hard border (§12) -->
    <div class="pointer-events-none absolute bottom-0 inset-x-0 h-6 bg-gradient-to-t from-white/40 to-transparent backdrop-blur-[2px]"></div>
  </section>

  <section class="py-7 md:py-10 bg-white">
    <div class="mx-auto max-w-[1280px] px-4 md:px-6">
      <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-5 md:gap-6 items-start">
        <!-- Contact cards — material depth (§12) -->
        <div class="space-y-4">
          <div class="grid sm:grid-cols-3 gap-3" data-stagger>
            <!-- Telegram — interruptible spring, 1:1 tracking ready -->
            <a href="https://t.me/mcdk8s" target="_blank" rel="noopener noreferrer" data-card class="pressable group relative overflow-hidden rounded-[16px] border border-border bg-white/80 backdrop-blur p-4 hover:shadow-card-hover transition-all text-left will-change-transform" style="backdrop-filter: blur(12px) saturate(160%);">
              <div class="absolute top-0 inset-x-0 h-[3px] bg-gradient-to-r from-[#229ED9] to-[#0A84C1]"></div>
              <div class="absolute inset-x-0 top-0 h-px bg-white/40"></div>
              <div class="w-10 h-10 rounded-[10px] bg-[#229ED9]/10 border border-[#229ED9]/15 text-[#229ED9] grid place-items-center">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21 5L3 11L9 13L15 19L21 5ZM9 13V19L15 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <p class="mt-3 font-mono text-[11px] font-semibold tracking-[0.12em] uppercase text-muted">Telegram</p>
              <p class="font-mono text-[14px] font-bold text-ink tracking-tight">@mcdk8s</p>
              <p class="mt-1 text-[12px] text-muted leading-snug">Mensaje directo. Ideal para coordinar rápido.</p>
              <span class="mt-3 inline-flex items-center gap-1 text-[12px] font-semibold text-[#229ED9]">Abrir Telegram <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span>
            </a>

            <!-- WhatsApp -->
            <a href="https://wa.me/5358312390" target="_blank" rel="noopener noreferrer" data-card class="pressable group relative overflow-hidden rounded-[16px] border border-border bg-white/80 backdrop-blur p-4 hover:shadow-card-hover transition-all text-left will-change-transform" style="backdrop-filter: blur(12px) saturate(160%);">
              <div class="absolute top-0 inset-x-0 h-[3px] bg-gradient-to-r from-[#25D366] to-[#128C7E]"></div>
              <div class="absolute inset-x-0 top-0 h-px bg-white/40"></div>
              <div class="w-10 h-10 rounded-[10px] bg-[#25D366]/10 border border-[#25D366]/15 text-[#128C7E] grid place-items-center">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21C16.97 21 21 16.97 21 12C21 7.03 16.97 3 12 3C7.03 3 3 7.03 3 12C3 13.5 3.4 14.9 4.1 16.1L3 21L7.9 19.9C9.1 20.6 10.5 21 12 21Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8.5 9.5C8.5 9.5 9.2 8 11 8C12.8 8 13.5 9.2 13.5 10.5C13.5 13 11 14.5 11 14.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <p class="mt-3 font-mono text-[11px] font-semibold tracking-[0.12em] uppercase text-muted">WhatsApp</p>
              <p class="font-mono text-[14px] font-bold text-ink tracking-tight">+53 58312390</p>
              <p class="mt-1 text-[12px] text-muted leading-snug">Respuesta en horario laboral Cuba.</p>
              <span class="mt-3 inline-flex items-center gap-1 text-[12px] font-semibold text-[#128C7E]">Abrir WhatsApp <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span>
            </a>

            <!-- Email -->
            <a href="mailto:manuel920928@gmail.com?subject=Solicitud%20de%20acceso%20ImportControl" data-card class="pressable group relative overflow-hidden rounded-[16px] border border-border bg-white/80 backdrop-blur p-4 hover:shadow-card-hover transition-all text-left will-change-transform" style="backdrop-filter: blur(12px) saturate(160%);">
              <div class="absolute top-0 inset-x-0 h-[3px] bg-gradient-to-r from-primary to-[#4CAF50]"></div>
              <div class="absolute inset-x-0 top-0 h-px bg-white/40"></div>
              <div class="w-10 h-10 rounded-[10px] bg-primary/10 border border-primary/15 text-primary grid place-items-center">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 6L12 12.5L20.5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <p class="mt-3 font-mono text-[11px] font-semibold tracking-[0.12em] uppercase text-muted">Correo</p>
              <p class="font-mono text-[12px] font-bold text-ink break-all tracking-tight">manuel920928@gmail.com</p>
              <p class="mt-1 text-[12px] text-muted leading-snug">Asunto pre-llenado para agilizar.</p>
              <span class="mt-3 inline-flex items-center gap-1 text-[12px] font-semibold text-primary">Enviar correo <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span>
            </a>
          </div>

          <!-- Quick copy — vibrancy over translucent (§12) -->
          <div class="rounded-[16px] border border-border bg-page/70 backdrop-blur p-4" style="backdrop-filter: blur(8px);">
            <p class="font-mono text-[11px] font-semibold tracking-[0.12em] uppercase text-ink/70">Copia rápida</p>
            <div class="mt-3 grid gap-2">
              <div class="flex items-center justify-between gap-2 bg-white border border-border rounded-[12px] px-3 py-2 shadow-sm">
                <span class="font-mono text-[12px] font-medium text-ink tracking-tight">Telegram: @mcdk8s</span>
                <button data-copy="mcdk8s" class="pressable shrink-0 rounded-full bg-ink text-white px-3 py-1 text-[11px] font-semibold hover:bg-black transition-colors">Copiar</button>
              </div>
              <div class="flex items-center justify-between gap-2 bg-white border border-border rounded-[12px] px-3 py-2 shadow-sm">
                <span class="font-mono text-[12px] font-medium text-ink tracking-tight">+5358312390</span>
                <button data-copy="+5358312390" class="pressable shrink-0 rounded-full bg-ink text-white px-3 py-1 text-[11px] font-semibold hover:bg-black transition-colors">Copiar</button>
              </div>
              <div class="flex items-center justify-between gap-2 bg-white border border-border rounded-[12px] px-3 py-2 shadow-sm">
                <span class="font-mono text-[12px] font-medium text-ink break-all tracking-tight">manuel920928@gmail.com</span>
                <button data-copy="manuel920928@gmail.com" class="pressable shrink-0 rounded-full bg-ink text-white px-3 py-1 text-[11px] font-semibold hover:bg-black transition-colors">Copiar</button>
              </div>
            </div>
            <p id="copy-msg" class="hidden mt-3 rounded-[12px] bg-primary text-white px-3 py-2 text-[11px] font-mono font-semibold text-center shadow-sm"></p>
          </div>

          <div class="rounded-[12px] border border-border bg-white p-4 flex gap-3 shadow-sm">
            <span class="w-8 h-8 rounded-full bg-info/10 border border-info/15 text-info grid place-items-center shrink-0">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M12 8V12L14.5 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </span>
            <p class="text-[13px] leading-[1.6] text-muted"><span class="font-semibold text-ink">Tiempo de respuesta:</span> habitualmente el mismo día en horario Cuba. Si no ves respuesta, escribe por el canal alternativo.</p>
          </div>
        </div>

        <!-- Form — bottom sheet material (Apple §12: dim + layer) -->
        <div data-sheet class="bg-white border border-border rounded-[16px] shadow-[0_8px_32px_rgba(0,0,0,0.08),0_1px_3px_rgba(0,0,0,0.06)] overflow-hidden will-change-transform">
          <div class="px-5 py-4 border-b border-border flex items-center justify-between bg-white/80 backdrop-blur" style="backdrop-filter: blur(12px);">
            <div>
              <p class="font-mono text-[11px] font-semibold tracking-[0.12em] uppercase text-muted">Formulario rápido</p>
              <p class="text-[13px] font-semibold text-ink tracking-tight">Cuéntame tu caso · te respondo directo</p>
            </div>
            <span class="hidden sm:inline-flex rounded-full bg-page border border-border px-2.5 py-1 font-mono text-[11px] text-muted">Sin backend · abre tu correo</span>
          </div>
          <form id="solicitud-form" class="p-5 grid gap-4">
            <label class="text-[12px] font-semibold text-ink">Nombre
              <input required name="nombre" placeholder="Manuel — Empresa / Cooperativa" class="mt-1.5 w-full h-10 rounded-[12px] border border-border bg-page px-3 text-[13px] placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors" />
            </label>
            <div class="grid sm:grid-cols-2 gap-3">
              <label class="text-[12px] font-semibold text-ink">Teléfono / WhatsApp
                <input name="telefono" placeholder="+53 5..." class="mt-1.5 w-full h-10 rounded-[12px] border border-border bg-page px-3 text-[13px] font-mono placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors" />
              </label>
              <label class="text-[12px] font-semibold text-ink">Correo
                <input type="email" name="correo" placeholder="tu@correo.cu" class="mt-1.5 w-full h-10 rounded-[12px] border border-border bg-page px-3 text-[13px] placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors" />
              </label>
            </div>
            <label class="text-[12px] font-semibold text-ink">¿Qué necesitas?
              <select name="motivo" class="mt-1.5 w-full h-10 rounded-[12px] border border-border bg-page px-3 text-[13px] focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors">
                <option>Solicitar acceso a ImportControl</option>
                <option>Demo guiada de 15 min</option>
                <option>Migrar mi Excel actual</option>
                <option>Consulta de precios / plan</option>
                <option>Soporte / otra consulta</option>
              </select>
            </label>
            <label class="text-[12px] font-semibold text-ink">Mensaje
              <textarea name="mensaje" rows="4" placeholder="Cuéntame brevemente: cuántos contenedores al mes, qué productos, y qué canal prefieres para que te contacte (Telegram/WhatsApp/correo)." class="mt-1.5 w-full rounded-[12px] border border-border bg-page px-3 py-2.5 text-[13px] placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors"></textarea>
            </label>
            <fieldset class="text-[12px] font-semibold text-ink">
              <legend class="mb-1.5">Canal preferido</legend>
              <div class="flex flex-wrap gap-2">
                <label class="pressable inline-flex items-center gap-1.5 rounded-full border border-border bg-page px-3 py-1.5 text-[12px] has-[:checked]:bg-primary has-[:checked]:text-white has-[:checked]:border-primary cursor-pointer transition-colors"><input type="radio" name="canal" value="Telegram" checked class="sr-only" /> Telegram</label>
                <label class="pressable inline-flex items-center gap-1.5 rounded-full border border-border bg-page px-3 py-1.5 text-[12px] has-[:checked]:bg-primary has-[:checked]:text-white has-[:checked]:border-primary cursor-pointer transition-colors"><input type="radio" name="canal" value="WhatsApp" class="sr-only" /> WhatsApp</label>
                <label class="pressable inline-flex items-center gap-1.5 rounded-full border border-border bg-page px-3 py-1.5 text-[12px] has-[:checked]:bg-primary has-[:checked]:text-white has-[:checked]:border-primary cursor-pointer transition-colors"><input type="radio" name="canal" value="Correo" class="sr-only" /> Correo</label>
              </div>
            </fieldset>
            <button type="submit" class="pressable mt-1 inline-flex items-center justify-center gap-1.5 h-11 rounded-full bg-primary text-white text-[13px] font-semibold hover:bg-[#0e6e0e] shadow-[0_2px_12px_rgba(16,124,16,0.25)]">
              Enviar solicitud
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </button>
            <p class="text-[11px] font-mono text-muted text-center">Al enviar, se abrirá tu cliente de correo con los datos pre-llenados a <span class="font-semibold text-ink">manuel920928@gmail.com</span>.</p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Apple §1 + §3: instant press feedback, interruptible */
    .pressable:active { transform: scale(0.97); transition: transform 100ms ease-out; }
    .pressable { transition: transform 100ms ease-out, box-shadow 200ms ease-out; }
    /* Apple §12: reduced transparency fallback */
    @media (prefers-reduced-transparency: reduce) {
      [style*="backdrop-filter"] { backdrop-filter: none !important; -webkit-backdrop-filter: none !important; background: white !important; }
    }
    /* Apple §14: reduced motion — cross-fade only, no spring */
    @media (prefers-reduced-motion: reduce) {
      [data-spring-enter], [data-stagger] > *, [data-card], [data-sheet] { animation: none !important; transform: none !important; }
    }
    /* Apple §15: heading tracking already via inline -0.02em */
  </style>

  <script>
    import { animate, stagger } from 'animejs';

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Apple §4: springs — damping 1.0 (no bounce) for chrome, 0.8 + bounce for momentum
    // Materialize (§12): blur + scale together on enter
    if (!prefersReduced) {
      // Hero: critically damped, no overshoot — graceful (§4)
      const hero = document.querySelector('[data-spring-enter]');
      if (hero) {
        animate(hero as any, {
          opacity: [0,1],
          translateY: [10,0],
          scale: [0.98,1],
          duration: 420,
          easing: 'spring(1, 80, 12, 0)' // damping 1.0, response ~0.35
        } as any);
      }
      // Cards stagger — behavior over animation, interruptible from current value
      const staggerEls = document.querySelectorAll('[data-stagger] [data-card], [data-stagger]');
      // Fallback: animate the 3 contact cards with velocity-aware stagger
      animate('[data-card]' as any, {
        opacity: [0,1],
        translateY: [12,0],
        scale: [0.96,1],
        delay: stagger(60, { start: 180 }),
        duration: 520,
        easing: 'spring(1, 90, 14, 0)'
      } as any);
      // Sheet: heavier material → stronger blur + deeper shadow, enters with scale (§12)
      const sheet = document.querySelector('[data-sheet]');
      if (sheet) {
        animate(sheet as any, {
          opacity: [0,1],
          translateY: [16,0],
          scale: [0.98,1],
          duration: 480,
          easing: 'spring(1, 80, 12, 0)'
        } as any);
      }
    } else {
      // Reduced motion: simple cross-fade, no spring (§14)
      document.querySelectorAll('[data-card],[data-sheet],[data-spring-enter]').forEach(el => {
        (el as HTMLElement).style.opacity = '1';
      });
    }

    // Apple §1: respond on pointer-down, not release — instant highlight + 1:1 tracking (§2)
    document.querySelectorAll('.pressable').forEach(el => {
      el.addEventListener('pointerdown', () => {
        if (prefersReduced) return;
        // Continuous feedback during interaction, interruptible from presentation value (§3)
        animate(el as any, { scale: 0.97, duration: 100, easing: 'easeOutQuad' } as any);
      });
      el.addEventListener('pointerup', () => {
        if (prefersReduced) return;
        animate(el as any, { scale: 1, duration: 220, easing: 'spring(1, 80, 12, 0)' } as any);
      });
      el.addEventListener('pointerleave', () => {
        if (prefersReduced) return;
        animate(el as any, { scale: 1, duration: 200, easing: 'easeOutQuad' } as any);
      });
      el.addEventListener('pointercancel', () => {
        animate(el as any, { scale: 1, duration: 200, easing: 'easeOutQuad' } as any);
      });
    });

    // Form — Apple §5: velocity handoff ready (track pointer history if draggable), here causal harmony (§13)
    const form = document.getElementById('solicitud-form') as HTMLFormElement | null;
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const nombre = String(data.get('nombre')||'');
      const telefono = String(data.get('telefono')||'');
      const correo = String(data.get('correo')||'');
      const motivo = String(data.get('motivo')||'');
      const mensaje = String(data.get('mensaje')||'');
      const canal = String(data.get('canal')||'Telegram');
      const subject = encodeURIComponent(`Solicitud de acceso ImportControl — ${motivo} — ${nombre}`);
      const body = encodeURIComponent(
        `Hola Manuel,\n\n`+
        `Quiero solicitar acceso a ImportControl.\n\n`+
        `Nombre: ${nombre}\n`+
        `Teléfono/WhatsApp: ${telefono}\n`+
        `Correo: ${correo}\n`+
        `Motivo: ${motivo}\n`+
        `Canal preferido: ${canal}\n\n`+
        `Mensaje:\n${mensaje}\n\n`+
        `---\n`+
        `Telegram: @mcdk8s\n`+
        `WhatsApp: +5358312390\n`
      );
      // Apple §13: harmony — visual + haptic same frame
      if (navigator.vibrate) navigator.vibrate(10);
      window.location.href = `mailto:manuel920928@gmail.com?subject=${subject}&body=${body}`;
    });

    // Copy — Apple §13 causal + utility, §10 tap hysteresis friendly
    document.querySelectorAll('[data-copy]').forEach(btn=>{
      btn.addEventListener('click', async ()=>{
        const val = (btn as HTMLElement).dataset.copy!;
        try{ await navigator.clipboard.writeText(val); } catch { const ta=document.createElement('textarea'); ta.value=val; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove(); }
        const msg = document.getElementById('copy-msg')!;
        msg.textContent = `✓ Copiado: ${val}`;
        msg.classList.remove('hidden');
        // Haptic + motion harmony
        if (navigator.vibrate) navigator.vibrate(12);
        if (!prefersReduced) {
          animate(msg as any, { scale: [0.96,1], opacity:[0,1], duration: 260, easing: 'spring(1, 80, 12, 0)' } as any);
        }
        setTimeout(()=> {
          if (!prefersReduced) animate(msg as any, { opacity:0, duration:180, easing:'easeOutQuad' } as any).then(()=> msg.classList.add('hidden'));
          else msg.classList.add('hidden');
        }, 2000);
      });
      // Apple §1: instant feedback on pointerdown for copy buttons too
      btn.addEventListener('pointerdown', () => {
        if (prefersReduced) return;
        animate(btn as any, { scale: 0.95, duration: 80, easing:'easeOutQuad' } as any);
      });
    });

    // Apple §11: only transform/opacity, will-change already set
  </script>
</BaseLayout>
