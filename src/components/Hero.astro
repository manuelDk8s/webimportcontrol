---
import KpiTile from './ui/KpiTile.astro';
import Badge from './ui/Badge.astro';
---

<section data-hero class="relative overflow-hidden bg-page border-b border-border">
  <!-- enterprise texture — radial cerrado + depth layer -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_50%_at_58%_-6%,rgba(16,124,16,0.10),transparent_62%)]"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-white/40 via-white/10 to-transparent"></div>
    <div class="hidden lg:block absolute -right-10 -bottom-24 w-[520px] h-[520px] rounded-full bg-[radial-gradient(circle_at_50%_50%,rgba(16,124,16,0.06),transparent_70%)] blur-[0.5px]"></div>
  </div>

  <div class="relative mx-auto max-w-[1280px] px-4 md:px-6 py-8 md:py-12 lg:py-16">
    <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-8 lg:gap-10 items-center">
      <!-- Left -->
      <div data-hero-item>
        <div class="inline-flex items-center gap-2 rounded-full border border-border bg-white px-3 py-1 text-[12px]">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          <span class="font-mono font-medium text-ink">Datos de ejemplo ilustrativos</span>
          <span class="text-muted">· no producción</span>
        </div>

        <h1 data-hero-item class="mt-5 font-sans font-semibold tracking-tight text-ink text-[32px] md:text-[44px] lg:text-[52px] leading-[0.95] text-balance">
          Cada importación,<br />
          <span class="text-primary">visible.</span> Cada costo,<br />
          trazable.
        </h1>

        <p data-hero-item class="mt-4 text-[16px] md:text-[17px] leading-relaxed text-muted max-w-[52ch]">
          ImportControl reemplaza Excel y papel con una <span class="font-semibold text-ink">fuente única de verdad</span> para todo el ciclo de importación en Cuba — del contenedor marítimo a la venta en POS y el dashboard.
        </p>

        <div data-hero-item class="mt-7 flex flex-wrap gap-3">
          <a href="/webimportcontrol/solicitud" class="inline-flex items-center justify-center h-11 px-7 rounded-full bg-primary text-white text-[14px] font-semibold hover:bg-[#0e6e0e] transition-colors shadow-[0_2px_8px_rgba(16,124,16,0.25)]">
            Solicitar acceso
            <svg class="ml-2" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>

        <div data-hero-item class="mt-6 flex flex-wrap items-center gap-3 text-[12px] text-muted">
          <span class="inline-flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-primary"></span> Pensado para doble moneda CUP/USD</span>
          <span class="hidden sm:inline text-border">·</span>
          <span class="inline-flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-info"></span> Offline-first · RBAC</span>
        </div>
      </div>

      <!-- Right: Mock Dashboard — 3D sutil enterprise (perspective sin rotación agresiva) -->
      <div data-hero-item data-hero-kpi class="relative [perspective:1200px]">
        <div class="absolute -inset-3 bg-white/55 rounded-[20px] blur-[6px] -z-10 hidden lg:block border border-white/40"></div>
        <div class="bg-white border border-border rounded-mock shadow-mock p-4 md:p-5 [transform-style:preserve-3d] lg:[transform:rotateX(1.2deg)_rotateY(-1.5deg)] will-change-transform">
          <div class="flex items-center justify-between gap-3 mb-4">
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 rounded-full bg-[#C93434]"></div>
              <div class="w-2 h-2 rounded-full bg-[#B45E00]"></div>
              <div class="w-2 h-2 rounded-full bg-primary"></div>
              <span class="ml-2 font-mono text-[11px] font-semibold tracking-wide text-muted">DASHBOARD · EJEMPLO</span>
            </div>
            <Badge variant="success">Ejemplo</Badge>
          </div>

          <div class="grid grid-cols-2 gap-3 md:gap-4">
            <KpiTile label="Contenedores totales" value="18" subtext="3 en tránsito · 2 en puerto" variant="info" trend="+3 mes">
              <svg slot="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="7" width="18" height="10" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M7 7V5.5C7 4.67 7.67 4 8.5 4H15.5C16.33 4 17 4.67 17 5.5V7" stroke="currentColor" stroke-width="1.6"/><path d="M3 11H21" stroke="currentColor" stroke-width="1.6"/></svg>
            </KpiTile>
            <KpiTile label="Costo total" value="4.2M CUP" subtext="USD 34.5k · tasa 320 CUP" variant="warning" trend="12 cont.">
              <svg slot="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3V21M12 3C10.5 3 9 4 9 6C9 8 12 9 12 9C12 9 15 10 15 12C15 14 13.5 15 12 15M12 21C13.5 21 15 20 15 18C15 16 12 15 12 15C12 15 9 14 9 12C9 10 10.5 9 12 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </KpiTile>
            <KpiTile label="Rentabilidad media" value="38.2%" subtext="vs 36.1% mes anterior" variant="success" trend="+2.1 pp">
              <svg slot="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 16L9 10L12 13L19 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M13 6H19V12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 20H19" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </KpiTile>
            <KpiTile label="Ventas del mes" value="1.8M CUP" subtext="124 tickets · 18.2% margen" variant="success" trend="CUP/USD">
              <svg slot="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 8H18M6 12H18M6 16H14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.6"/></svg>
            </KpiTile>
          </div>

          <div class="mt-4 rounded-[10px] border border-border overflow-hidden">
            <div class="bg-page px-3 py-2 flex items-center justify-between">
              <span class="font-mono text-[11px] font-semibold tracking-wide text-muted">ÚLTIMOS CONTENEDORES · EJEMPLO</span>
              <span class="font-mono text-[10px] text-muted">Actualizado hoy 09:42</span>
            </div>
            <div class="divide-y divide-border">
              <div class="flex items-center justify-between px-3 py-2 text-[13px]">
                <span class="font-mono text-ink">CNT-2026-014 · En tránsito</span>
                <span class="inline-flex rounded-full bg-info/10 text-info text-[10px] font-semibold px-2 py-1">EN TRÁNSITO</span>
              </div>
              <div class="flex items-center justify-between px-3 py-2 text-[13px]">
                <span class="font-mono text-ink">CNT-2026-013 · En puerto</span>
                <span class="inline-flex rounded-full bg-warning/10 text-warning text-[10px] font-semibold px-2 py-1">EN PUERTO</span>
              </div>
              <div class="flex items-center justify-between px-3 py-2 text-[13px]">
                <span class="font-mono text-ink">CNT-2026-012 · Recibido empresa</span>
                <span class="inline-flex rounded-full bg-primary/10 text-primary text-[10px] font-semibold px-2 py-1">RECIBIDO</span>
              </div>
            </div>
          </div>
        </div>

        <div class="hidden md:flex absolute -bottom-3 -left-3 bg-ink text-white rounded-full px-3.5 py-2 text-[11px] font-mono font-medium shadow-lg items-center gap-2 border border-white/10 [transform:translateZ(24px)]">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span> Sincronización offline-first
        </div>
      </div>
    </div>
  </div>
</section>
