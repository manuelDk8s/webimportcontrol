---
import Card from './ui/Card.astro';
const items = [
  { title: 'RBAC', desc: 'Control de acceso basado en roles y permisos. Cada quien ve y hace solo lo que le corresponde.', color: 'bg-primary/10 text-primary border-primary/15', icon: 'M12 12C14.2 12 16 10.2 16 8C16 5.8 14.2 4 12 4C9.8 4 8 5.8 8 8C8 10.2 9.8 12 12 12ZM5 20V18C5 15.8 6.8 14 9 14H15C17.2 14 19 15.8 19 18V20M12 8V10M12 14H12.01' },
  { title: 'Auditoría', desc: 'Cada cambio queda registrado con antes/después en JSON. Log append-only, trazabilidad total.', color: 'bg-info/10 text-info border-info/15', icon: 'M9 5H15M12 9V13M12 17H12.01M7 3H17L21 7V21H7V3ZM15 3V7H21' },
  { title: 'Offline-first', desc: 'El sistema sigue operando aunque falle la conexión. SyncVersion, PosDevice e idempotencia por operation_id.', color: 'bg-warning/10 text-warning border-warning/15', icon: 'M12 3L4 7V12C4 16 8 20 12 21C16 20 20 16 20 12V7L12 3ZM12 8V12L14.5 14.5' },
  { title: 'Feature Flags', desc: 'Módulos que se pueden activar o desactivar sin despliegue. Kill-switch por módulo.', color: 'bg-danger/10 text-danger border-danger/15', icon: 'M4 6H20M4 10H20M4 14H14M6 18H10M14 18H18' },
];
---

<section id="tecnologia" class="py-12 md:py-20 bg-white border-y border-border">
  <div class="mx-auto max-w-[1280px] px-4 md:px-6">
    <div class="max-w-[720px]">
      <p class="font-mono text-[11px] font-semibold tracking-[0.18em] uppercase text-primary">Tecnología y Confianza</p>
      <h2 class="mt-2 font-sans text-[28px] md:text-[34px] font-semibold tracking-tight text-ink leading-[1.05]">Seguro, trazable y resiliente</h2>
      <p class="mt-3 text-[14px] text-muted leading-relaxed">Cuatro pilares que protegen el dato y la operación — inspirados en la arquitectura real Django + Vue + Chart.js.</p>
    </div>

    <div data-reveal-grid class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
      {
        items.map((item) => (
          <Card class="p-5" data-item data-hover-lift>
            <div class:list={["w-10 h-10 rounded-[10px] border grid place-items-center", item.color]}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d={item.icon} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <h3 class="mt-3 text-[14px] font-semibold text-ink">{item.title}</h3>
            <p class="mt-1 text-[13px] leading-relaxed text-muted">{item.desc}</p>
          </Card>
        ))
      }
    </div>
  </div>
</section>
