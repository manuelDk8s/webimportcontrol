  { icon: 'M6 6H18M6 10H18M6 14H14M5 3H19C19.6 3 20 3.4 20 4V20C20 20.6 19.6 21 19 21H5C4.4 21 4 20.6 4 20V4C4 3.4 4.4 3 5 3Z', title: 'Productos', que: 'Catálogo por contenedor, con categorías, unidades y clasificación Tipo 1/2 automática según la ficha de costo.', utilidad: 'Inventario siempre vinculado a su origen.', variant: 'success' },
