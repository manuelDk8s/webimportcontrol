  { icon: 'M12 3V21M8 7H16M8 11H16M8 15H16M7 3H17L21 7V21H7V3ZM15 3V7H21', title: 'Tasas de Cambio', que: 'Tasa diaria CUP/USD con histórico.', utilidad: 'Es la base de todo cálculo dual del sistema.', variant: 'info' },
  { icon: 'M4 6H20M4 10H20M4 14H14M7 18H10M14 18H18', title: 'Ventas', que: 'Registro con importe y ganancia en CUP/USD, vinculado a ticket, almacén, caja y cliente; incluye ventas por cobrar.', utilidad: 'Cada venta queda trazada de punta a punta.', variant: 'success' },
  { icon: 'M12 12C14.2 12 16 10.2 16 8C16 5.8 14.2 4 12 4C9.8 4 8 5.8 8 8C8 10.2 9.8 12 12 12ZM4 20C4 16.7 6.7 14 10 14H14C17.3 14 20 16.7 20 20V21H4V20Z', title: 'Clientes', que: 'CRUD con CI y contacto, con soporte para tickets nominativos.', utilidad: 'Control de deuda y relación comercial por cliente.', variant: 'info' },
  { icon: 'M5 7H19M5 11H19M5 15H15M7 3H17L21 7V21H7V3ZM15 3V7H21M9 20H15', title: 'POS', que: 'Turnos con arqueo, tickets consecutivos por turno, precios por punto de venta, tasa diaria y retiros de caja.', utilidad: 'Caja siempre cuadrada y auditable.', variant: 'success' },
  { icon: 'M3 8H21M5 8V17H19V8M7 12H17', title: 'Almacén POS', que: 'Transferencias de Central a Tienda, stock local, reparto a cajas, salidas a costo (merma, consumo, entrega).', utilidad: 'El stock en tienda nunca se pierde de vista.', variant: 'success' },
  { icon: 'M7 7H17M7 11H17M7 15H13M5 3H19C19.6 3 20 3.4 20 4V20C20 20.6 19.6 21 19 21H5C4.4 21 4 20.6 4 20V4C4 3.4 4.4 3 5 3Z', title: 'Consolidación por Cajas (Ventas Cajas)', que: 'Resúmenes diarios en flujo borrador → confirmado → procesado que generan ventas reales; pensado para digitación masiva de planillas.', utilidad: 'Cierra el día rápido sin perder trazabilidad.', variant: 'info' },
  { icon: 'M12 3L20 7V17L12 21L4 17V7L12 3ZM12 3V21M8 10H16M8 14H16', title: 'Dispatch', que: 'Cola pendiente → en preparación → lista → entregado, entre caja y almacén, para entregas físicas post-pago.', utilidad: 'Nadie se lleva algo que no se despachó formalmente.', variant: 'warning' },
  { icon: 'M3 9H21M9 9V21M3 9L12 3L21 9V21H3V9Z', title: 'Inventario', que: 'Consumos internos, pérdidas (rotura, vencimiento), entregas y donaciones, todo con snapshot a costo.', utilidad: 'Cada salida de stock queda justificada y valorada.', variant: 'danger' },
  { icon: 'M7 3H17L21 7V21H7V3ZM15 3V7H21M9 12H15M9 16H15', title: 'Documentos', que: 'Adjuntos tipificados (BL, factura, declaración aduanal) por contenedor.', utilidad: 'Toda la papelería de importación en un solo lugar.', variant: 'neutral' },
  { icon: 'M5 12L9 8L12 11L19 4M5 20H19', title: 'Dashboard', que: 'Endpoint único con 8 secciones (resumen, financiero, ventas, inventario, logística, timeline, alertas, gráficos) y 12 gráficos con Chart.js.', utilidad: 'La foto completa del negocio en una sola vista.', variant: 'info' },
  { icon: 'M8 10H16M8 14H13M12 3C16.97 3 21 7.03 21 12C21 16.97 16.97 21 12 21C7.03 21 3 16.97 3 12C3 7.03 7.03 3 12 3Z', title: 'Comunicación', que: 'Chat privado y grupal, con adjuntos, presencia en línea y notificaciones en tiempo real.', utilidad: 'El equipo coordina sin salir del sistema.', variant: 'info' },
  { icon: 'M12 8C12 8 10 6 8 8C6 10 8 13 12 16C16 13 18 10 16 8C14 6 12 8 12 8ZM12 16V20M9 20H15', title: 'Asistente IA', que: 'Chat en lenguaje natural con cerca de 25 intents (stock, ventas, contenedores, costos), basado en reglas y sin persistencia.', utilidad: 'Preguntas rápidas sin tener que navegar reportes.', variant: 'success' },
  { icon: 'M9 5H15M12 9V13M12 17H12.01M7 3H17L21 7V21H7V3ZM15 3V7H21', title: 'Auditoría', que: 'Log append-only con el antes y el después en JSON de cada cambio.', utilidad: 'Trazabilidad total de quién cambió qué y cuándo.', variant: 'danger' },
  { icon: 'M12 12C14.2 12 16 10.2 16 8C16 5.8 14.2 4 12 4C9.8 4 8 5.8 8 8C8 10.2 9.8 12 12 12ZM5 20V18C5 15.8 6.8 14 9 14H15C17.2 14 19 15.8 19 18V20', title: 'Usuarios', que: 'Roles: admin, logística, compras, gerencia, viewer, cajera, jefe, despacho, con RBAC por permisos.', utilidad: 'Cada quien ve y hace solo lo que le corresponde.', variant: 'danger' },
  { icon: 'M12 3L4 7V12C4 16 8 20 12 21C16 20 20 16 20 12V7L12 3ZM12 8V14M12 17H12.01', title: 'Core / Feature Flags + POS API', que: 'Kill-switch por módulo sin necesidad de despliegue, y API offline-first (SyncVersion, PosDevice, idempotencia por operation_id).', utilidad: 'El sistema sigue funcionando aunque falle la conexión, y se puede apagar un módulo puntual sin afectar el resto.', variant: 'ink' },
