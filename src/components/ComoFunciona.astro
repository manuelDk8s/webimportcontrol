---
const steps = [
  { n: '01', label: 'Contenedor marítimo', sub: 'Origen y embarque', icon: 'M3 8H21M3 8V14C3 15.1 3.9 16 5 16H19C20.1 16 21 15.1 21 14V8M3 8C3 6.9 3.9 6 5 6H19C20.1 6 21 6.9 21 8' },
  { n: '02', label: 'Puerto y Aduana', sub: 'BL · Declaración', icon: 'M12 3L20 7V17L12 21L4 17V7L12 3ZM12 3V21M4 7L12 11L20 7' },
  { n: '03', label: 'Transporte y Almacén', sub: 'Central → Tienda', icon: 'M3 8H15L18 11V16H3V8ZM15 8V5H19L21 8M6 18C7.1 18 8 17.1 8 16C8 14.9 7.1 14 6 14C4.9 14 4 14.9 4 16C4 17.1 4.9 18 6 18ZM18 18C19.1 18 20 17.1 20 16C20 14.9 19.1 14 18 14C16.9 14 16 14.9 16 16C16 17.1 16.9 18 18 18Z' },
  { n: '04', label: 'Catalogación y Ficha de Costo', sub: 'CUP/USD · Rentabilidad', icon: 'M7 3H17L21 7V21H7V3ZM15 3V7H21M9 12H15M9 16H15' },
  { n: '05', label: 'Venta / POS', sub: 'Turno · Ticket · Arqueo', icon: 'M4 6H20M4 10H20M4 14H14M6 18H10M14 18H18M4 4C4 3.4 4.4 3 5 3H19C19.6 3 20 3.4 20 4V18C20 18.6 19.6 19 19 19H5C4.4 19 4 18.6 4 18V4Z' },
  { n: '06', label: 'Inventario y Dashboard', sub: '8 secciones · 12 gráficos', icon: 'M5 12L9 8L12 11L19 4M19 4H14M19 4V9M5 20H19' },
];
---

<section id="como-funciona" class="py-12 md:py-20 bg-white border-y border-border">
  <div class="mx-auto max-w-[1280px] px-4 md:px-6">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4">
      <div>
        <h2 class="font-sans text-[28px] md:text-[34px] font-semibold tracking-tight text-ink leading-[1.05]" style="letter-spacing:-0.02em;">Flujo continuo, de punta a punta</h2>
        <p class="mt-2 text-[14px] leading-[1.6] text-muted max-w-[60ch]">Del contenedor marítimo al dashboard. Cada nodo queda trazado, valorado en CUP/USD y auditable.</p>
      </div>
      <span class="hidden lg:inline-flex items-center rounded-full bg-page border border-border px-3 py-1 font-mono text-[11px] font-semibold text-muted">6 pasos · end-to-end</span>
    </div>

    <!-- Desktop horizontal — flujo constante módulo a módulo (mismo sistema visual que toda la web) -->
    <div data-reveal-timeline class="hidden lg:block mt-10">
      <div id="flow-track-h" class="relative">
        <div class="absolute top-[32px] left-[48px] right-[48px] h-[2px] bg-gradient-to-r from-primary via-info to-primary opacity-20 rounded-full"></div>
        <div class="absolute top-[32px] left-[48px] right-[48px] h-[2px] pointer-events-none overflow-hidden rounded-full" aria-hidden="true">
          <div id="flow-dot-h" class="absolute top-1/2 -translate-y-1/2 w-[10px] h-[10px] rounded-full bg-primary shadow-[0_0_0_4px_rgba(16,124,16,0.18),0_0_10px_rgba(16,124,16,0.45)] will-change-transform" style="left:-10px;"></div>
          <div id="flow-trail-h" class="absolute top-1/2 -translate-y-1/2 h-[2px] w-[40px] bg-gradient-to-r from-transparent via-primary/70 to-primary opacity-60 rounded-full will-change-transform" style="left:-40px;"></div>
        </div>
        <div class="absolute top-[32px] left-[48px] right-[48px] h-[64px] -translate-y-[32px] pointer-events-none hidden lg:block" aria-hidden="true">
          <div class="grid grid-cols-6 gap-4 h-full">
            {steps.map((_, i) => (
              <div class="flex justify-center items-start pt-[26px]"><span data-flow-pulse={i} class="w-[14px] h-[14px] rounded-full bg-primary/20 border border-primary/30 opacity-0 will-change-transform"></span></div>
            ))}
          </div>
        </div>
        <div id="flow-nodes-h" class="grid grid-cols-6 gap-4">
          {
            steps.map((s, i) => (
              <div data-flow-node={i} class="relative flex flex-col items-center text-center group" style={`animation-delay: ${i*60}ms`}>
                <div class="flow-core w-[64px] h-[64px] rounded-[14px] bg-white border border-border shadow-card grid place-items-center group-hover:shadow-card-hover group-hover:-translate-y-1 transition-all duration-200 will-change-transform">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d={s.icon} stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
                <span class="mt-3 inline-flex items-center justify-center w-6 h-6 rounded-full bg-primary text-white font-mono text-[10px] font-bold">{s.n}</span>
                <p class="mt-2 text-[13px] font-semibold text-ink leading-tight">{s.label}</p>
                <p class="text-[11px] font-mono text-muted">{s.sub}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Mobile vertical — mismo sistema -->
    <div data-reveal-timeline class="lg:hidden mt-8 relative">
      <div id="flow-track-v" class="absolute left-[31px] top-4 bottom-4 w-[2px] bg-gradient-to-b from-primary via-info to-primary opacity-15 rounded-full"></div>
      <div class="absolute left-[31px] top-4 bottom-4 w-[2px] pointer-events-none overflow-hidden rounded-full" aria-hidden="true">
        <div id="flow-dot-v" class="absolute left-1/2 -translate-x-1/2 w-[10px] h-[10px] rounded-full bg-primary shadow-[0_0_0_4px_rgba(16,124,16,0.18),0_0_10px_rgba(16,124,16,0.45)] will-change-transform" style="top:-10px;"></div>
        <div id="flow-trail-v" class="absolute left-1/2 -translate-x-1/2 w-[2px] h-[40px] bg-gradient-to-b from-transparent via-primary/70 to-primary opacity-60 rounded-full will-change-transform" style="top:-40px;"></div>
      </div>
      <div id="flow-nodes-v" class="flex flex-col gap-5">
        {
          steps.map((s) => (
            <div class="flex gap-4 items-start">
              <div class="relative w-[64px] h-[64px] rounded-[14px] bg-white border border-border shadow-card grid place-items-center shrink-0 will-change-transform">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d={s.icon} stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="absolute -bottom-1 -right-1 w-5 h-5 rounded-full bg-primary text-white grid place-items-center font-mono text-[9px] font-bold">{s.n}</span>
              </div>
              <div class="pt-2">
                <p class="text-[14px] font-semibold text-ink">{s.label}</p>
                <p class="text-[12px] font-mono text-muted">{s.sub}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { animate } from 'motion';
  const mql = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!mql.matches) {
    const trackH = document.getElementById('flow-track-h');
    const dotH = document.getElementById('flow-dot-h');
    const trailH = document.getElementById('flow-trail-h');
    const nodesH = Array.from(document.querySelectorAll('[data-flow-node]'));
    const pulsesH = Array.from(document.querySelectorAll('[data-flow-pulse]'));
    const trackV = document.getElementById('flow-track-v');
    const dotV = document.getElementById('flow-dot-v');
    const trailV = document.getElementById('flow-trail-v');
    const nodesV = Array.from(document.querySelectorAll('#flow-nodes-v > div'));

    // Apple fluid: spring desde valor presentación, interruptible, bounce sutil solo con momentum (§4)
    let idxH = 0;
    let pausedH = false;

    function posH() {
      if (!trackH || !nodesH.length) return [];
      const w = trackH.getBoundingClientRect().width - 96;
      return nodesH.map((_, i) => 48 + (w / 5) * i - 5);
    }

    async function loopH() {
      if (pausedH || !dotH || !trackH) return;
      const pp = posH();
      if (!pp.length) return;
      const t = pp[idxH];
      const isWrap = idxH === 0 && pp.length > 1;
      const spring = isWrap ? { type: 'spring' as const, bounce: 0, duration: 0.45 } : { type: 'spring' as const, bounce: 0.14, duration: 0.55 };
      animate(dotH as any, { x: t + 5 } as any, spring as any);
      if (trailH) animate(trailH as any, { x: t - 35 } as any, { type: 'spring', bounce: 0, duration: 0.6 } as any);
      const core = nodesH[idxH]?.querySelector('.flow-core') as HTMLElement;
      const pulse = pulsesH[idxH] as HTMLElement;
      if (core) {
        animate(core as any, { scale: [1, 1.04, 1], y: [0, -1, 0] } as any, { duration: 0.5, ease: [0.32, 0.72, 0, 1] } as any);
        const prevBorder = core.style.borderColor;
        core.style.borderColor = 'rgba(16,124,16,0.28)';
        core.style.boxShadow = '0 6px 18px rgba(16,124,16,0.13), 0 0 0 7px rgba(16,124,16,0.07)';
        setTimeout(() => { core.style.borderColor = prevBorder || ''; core.style.boxShadow = ''; }, 520);
      }
      if (pulse) {
        pulse.style.opacity = '1';
        animate(pulse as any, { scale: [0.7, 1.6, 0.7], opacity: [0, 0.9, 0] } as any, { duration: 0.6, ease: 'easeOut' } as any);
      }
      await new Promise(r => setTimeout(r, 520));
      idxH = (idxH + 1) % pp.length;
      setTimeout(loopH, 420);
    }

    // Apple §1: respuesta en pointerdown + §3 interruptible hover pausa
    nodesH.forEach(n => {
      n.addEventListener('pointerdown', () => {
        const c = n.querySelector('.flow-core') as HTMLElement;
        if (c) animate(c as any, { scale: 0.97 } as any, { duration: 0.1 } as any);
      });
      n.addEventListener('pointerup', () => {
        const c = n.querySelector('.flow-core') as HTMLElement;
        if (c) animate(c as any, { scale: 1 } as any, { type: 'spring', bounce: 0.18, duration: 0.35 } as any);
      });
      n.addEventListener('pointerleave', () => {
        const c = n.querySelector('.flow-core') as HTMLElement;
        if (c) animate(c as any, { scale: 1 } as any, { duration: 0.18 } as any);
      });
      n.addEventListener('pointerenter', () => { pausedH = true; });
      n.addEventListener('pointerleave', () => { if (pausedH) { pausedH = false; loopH(); } });
    });

    const ioH = new IntersectionObserver(es => { es.forEach(e => { if (e.isIntersecting) { loopH(); ioH.disconnect(); } }); }, { threshold: 0.2 });
    if (trackH) ioH.observe(trackH);

    // Mobile vertical spring loop
    let idxV = 0;
    async function loopV() {
      if (!dotV || !trackV) return;
      const tr = trackV.getBoundingClientRect();
      const rects = nodesV.map(n => n.getBoundingClientRect());
      const pp = rects.map(r => r.top - tr.top + r.height/2 - 5);
      const t = pp[idxV];
      animate(dotV as any, { y: t } as any, { type: 'spring', bounce: 0.12, duration: 0.5 } as any);
      if (trailV) animate(trailV as any, { y: t - 20 } as any, { type: 'spring', bounce: 0, duration: 0.55 } as any);
      const cv = nodesV[idxV]?.querySelector('div') as HTMLElement;
      if (cv) {
        animate(cv as any, { scale: [1, 1.03, 1] } as any, { duration: 0.4, ease: [0.32, 0.72, 0, 1] } as any);
        const pb = cv.style.borderColor; cv.style.borderColor = 'rgba(16,124,16,0.26)'; setTimeout(()=>cv.style.borderColor=pb||'',480);
      }
      await new Promise(r => setTimeout(r, 520));
      idxV = (idxV + 1) % pp.length;
      setTimeout(loopV, 380);
    }
    const ioV = new IntersectionObserver(es => { es.forEach(e => { if (e.isIntersecting) { loopV(); ioV.disconnect(); } }); }, { threshold: 0.15 });
    if (trackV) ioV.observe(trackV);
  }
</script>

<style>
  @media (prefers-reduced-motion: reduce) {
    #flow-dot-h, #flow-trail-h, #flow-dot-v, #flow-trail-v { animation: none !important; }
    .flow-core { transform: none !important; }
  }
</style>
