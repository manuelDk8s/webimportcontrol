---
import Card from './ui/Card.astro';
import Badge from './ui/Badge.astro';
---

<section id="pos" class="py-12 md:py-20 bg-white border-y border-border">
  <div class="mx-auto max-w-[1280px] px-4 md:px-6">
    <div class="grid lg:grid-cols-[0.95fr_1.05fr] gap-8 lg:gap-10 items-start">
      <div>
        <h2 class="font-sans text-[28px] md:text-[34px] font-semibold tracking-tight text-ink leading-[1.05]" style="letter-spacing:-0.02em;">Caja cuadrada, siempre auditable</h2>
        <p class="mt-2 text-[14.5px] leading-[1.6] text-muted max-w-[60ch]">Mi Caja, precios por punto y retiros — con trazabilidad hasta el contenedor. Enterprise-grade para tienda y caja.</p>

        <div data-reveal-grid class="mt-6 grid gap-4">
          <Card class="p-4 flex gap-3" data-item data-hover-lift>
            <div class="w-9 h-9 rounded-[9px] bg-primary/10 text-primary grid place-items-center shrink-0">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="7" width="18" height="10" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M7 7V5C7 3.9 7.9 3 9 3H15C16.1 3 17 3.9 17 5V7" stroke="currentColor" stroke-width="1.6"/></svg>
            </div>
            <div>
              <h3 class="text-[14px] font-semibold text-ink">Mi Caja: turnos y arqueo</h3>
              <p class="text-[13px] text-muted leading-relaxed">Apertura, cierre y arqueo por turno. Tickets consecutivos, sin saltos.</p>
            </div>
          </Card>
          <Card class="p-4 flex gap-3" data-item data-hover-lift>
            <div class="w-9 h-9 rounded-[9px] bg-info/10 text-info grid place-items-center shrink-0">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 8C12 8 10 6 8 6C6 6 4 8 4 10C4 14 12 19 12 19C12 19 20 14 20 10C20 8 18 6 16 6C14 6 12 8 12 8Z" stroke="currentColor" stroke-width="1.6"/></svg>
            </div>
            <div>
              <h3 class="text-[14px] font-semibold text-ink">Precios por punto</h3>
              <p class="text-[13px] text-muted leading-relaxed">Cada punto de venta puede tener su propio precio. CUP/USD con tasa del día.</p>
            </div>
          </Card>
          <Card class="p-4 flex gap-3" data-item data-hover-lift>
            <div class="w-9 h-9 rounded-[9px] bg-warning/10 text-warning grid place-items-center shrink-0">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 14H18L19 7H5L6 14ZM6 14C6 15.1 6.9 16 8 16C9.1 16 10 15.1 10 14M18 14C18 15.1 17.1 16 16 16C14.9 16 14 15.1 14 14M6 7V5C6 3.9 6.9 3 8 3H16C17.1 3 18 3.9 18 5V7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <div>
              <h3 class="text-[14px] font-semibold text-ink">Retiros de efectivo</h3>
              <p class="text-[13px] text-muted leading-relaxed">Control total de retiros de caja, con justificación y trazabilidad.</p>
            </div>
          </Card>
        </div>
      </div>

      <!-- Mock caja -->
      <div data-reveal class="bg-page border border-border rounded-[16px] p-4 md:p-5 shadow-card">
        <div class="bg-white border border-border rounded-card overflow-hidden">
          <div class="px-4 py-3 flex items-center justify-between border-b border-border bg-white">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
              <span class="font-mono text-[12px] font-semibold text-ink">Turno #042 · Abierto</span>
              <Badge variant="success">Caja 01</Badge>
            </div>
            <span class="font-mono text-[11px] text-muted">09/09/2026 · 14:22</span>
          </div>
          <div class="p-4">
            <div class="grid grid-cols-3 gap-3">
              <div class="rounded-[10px] bg-page border border-border p-3 text-center">
                <p class="text-[11px] font-mono uppercase tracking-wide text-muted">Ventas hoy</p>
                <p class="font-mono text-[16px] font-semibold text-ink">38</p>
              </div>
              <div class="rounded-[10px] bg-primary text-white p-3 text-center">
                <p class="text-[11px] font-mono uppercase tracking-wide text-white/80">Total</p>
                <p class="font-mono text-[16px] font-bold">1.24M CUP</p>
              </div>
              <div class="rounded-[10px] bg-page border border-border p-3 text-center">
                <p class="text-[11px] font-mono uppercase tracking-wide text-muted">Tickets</p>
                <p class="font-mono text-[16px] font-semibold text-ink">#042-001 → 038</p>
              </div>
            </div>
            <div class="mt-4 space-y-2">
              <div class="flex items-center justify-between text-[12px] font-mono">
                <span class="text-muted">Tasa del día</span><span class="font-semibold text-ink">1 USD = 320 CUP</span>
              </div>
              <div class="flex items-center justify-between text-[12px] font-mono">
                <span class="text-muted">Efectivo en caja</span><span class="font-semibold text-ink">860,400 CUP</span>
              </div>
              <div class="flex items-center justify-between text-[12px] font-mono">
                <span class="text-muted">Retiros</span><span class="font-semibold text-warning">120,000 CUP</span>
              </div>
            </div>
            <div class="mt-4 flex gap-2">
              <button disabled class="flex-1 h-9 rounded-full bg-primary text-white font-semibold text-[13px] opacity-90">Arqueo</button>
              <button disabled class="flex-1 h-9 rounded-full bg-white border border-border text-ink font-medium text-[13px]">Retiro</button>
            </div>
            <p class="mt-2 text-[11px] font-mono text-muted text-center">Mock ilustrativo · datos de ejemplo</p>
          </div>
        </div>
        <div class="mt-3 flex items-center justify-center gap-2 text-[11px] font-mono text-muted">
          <span class="w-1.5 h-1.5 rounded-full bg-info"></span> Precios por punto · tasa diaria congelada por ticket
        </div>
      </div>
    </div>
  </div>
</section>
