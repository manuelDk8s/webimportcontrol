---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, description, align = 'left' } = Astro.props;
---

<div class:list={["max-w-[720px]", align === 'center' && "mx-auto text-center"]}>
  {eyebrow && <p class="font-mono text-[11px] font-semibold tracking-[0.18em] uppercase text-primary mb-3">{eyebrow}</p>}
  <h2 class="font-sans text-[28px] md:text-[36px] font-semibold tracking-tight text-ink leading-[1.05] text-balance">{title}</h2>
  {description && <p class="mt-3 text-[15px] leading-relaxed text-muted max-w-[60ch]">{description}</p>}
</div>
