---
interface Props {
  label: string;
  value: string;
  subtext: string;
  variant?: 'success' | 'info' | 'warning' | 'danger';
  icon?: string;
  trend?: string;
}
const { label, value, subtext, variant = 'success', trend } = Astro.props;
const colors: Record<string, { bar: string; iconBg: string; iconColor: string }> = {
  success: { bar: 'from-[#107C10] to-[#4CAF50]', iconBg: 'bg-[#107C10]/10', iconColor: 'text-[#107C10]' },
  info: { bar: 'from-[#0078D4] to-[#40A9FF]', iconBg: 'bg-[#0078D4]/10', iconColor: 'text-[#0078D4]' },
  warning: { bar: 'from-[#B45E00] to-[#FF8C00]', iconBg: 'bg-[#B45E00]/10', iconColor: 'text-[#B45E00]' },
  danger: { bar: 'from-[#C93434] to-[#FF6B6B]', iconBg: 'bg-[#C93434]/10', iconColor: 'text-[#C93434]' },
};
const c = colors[variant];
---

<div data-item data-hover-lift class="relative overflow-hidden bg-white border border-border rounded-card shadow-card hover:shadow-card-hover transition-all duration-200 group">
  <div class:list={["h-[3px] w-full bg-gradient-to-r", c.bar]}></div>
  <div class="p-4">
    <div class="flex items-start justify-between gap-3">
      <div class:list={["w-[46px] h-[46px] rounded-[8px] grid place-items-center shrink-0", c.iconBg, c.iconColor]}>
        <slot name="icon">
          <!-- default icon -->
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-width="1.6"/><path d="M7 15.5L10.5 11L13 13.5L17 8.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="15.5" cy="7.5" r="1.5" fill="currentColor"/></svg>
        </slot>
      </div>
      {trend && <span class:list={["inline-flex items-center rounded-full px-2 py-1 text-[10px] font-mono font-semibold", variant === 'danger' ? 'bg-[#C93434]/10 text-[#C93434]' : 'bg-[#107C10]/10 text-[#107C10]']}>{trend}</span>}
    </div>
    <p class="mt-3 text-[11px] font-medium uppercase tracking-[0.08em] text-muted">{label}</p>
    <p class="mt-1 font-mono text-[26px] font-semibold tracking-tight text-ink leading-none">{value}</p>
    <p class="mt-1.5 text-[12px] text-muted leading-snug">{subtext}</p>
  </div>
</div>
